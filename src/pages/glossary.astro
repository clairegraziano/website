<script>let filter='All';const input=document.querySelector('#search');const cards=[...document.querySelectorAll('.card')];const count=document.querySelector('#count');const empty=document.querySelector('#empty');function update(){let n=0;for(const card of cards){const match=card.dataset.search.includes(input.value.trim().toLowerCase())&&(filter==='All'||(filter==='ECM-IT'?card.dataset.tag.startsWith('ECM-IT'):card.dataset.tag===filter));card.hidden=!match;if(match)n++}count.textContent=n+' terms';empty.hidden=n!==0}input.addEventListener('input',update);document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter;document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b===button));update()}));</script>
