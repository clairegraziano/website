---
import Layout from '../layouts/Layout.astro';
const workshops = [
  {day:'Friday',date:'27 November 2026',title:'Understanding the Body Through the Extracellular Matrix',subtitle:'Knowledge, exploration & somatic understanding',audience:'Open to therapists, counsellors, psychotherapists, osteopaths, yoga and movement practitioners, and interested learners.',topics:['The extracellular matrix and fascia/ECM matrix lines','Protective responses, contraction, connection and expansion','Trauma, the nervous system and the endocannabinoid system','Somatic awareness, movement and breath','The Golden Triangle: Awareness, Validation and Breath','ECM-IT clinical observations and developing hypotheses']},
  {day:'Saturday',date:'28 November 2026',title:'Innovative Somatic Bodywork & Whole-Body ECM Integration',subtitle:'Experiential, hands-on practitioner training',audience:'Designed for body therapists and practitioners with relevant hands-on experience.',topics:['Experiencing and reading fascia/ECM matrix lines','Recognising patterns of protection and expansion','Exploring changes in tissue glide and responsiveness','Therapeutic attunement and practitioner presence','Supporting the body to initiate its own release','Integrating movement, breath and embodied awareness']}
];
---
<Layout>
  <div class="page">
    <header class="header"><a class="brand" href="/">Somatics <em>&</em> Embodiment <small>with Claire Graziano</small></a><nav><a href="/">Home</a><a href="#days">Workshop days</a><a href="#booking">Booking</a></nav></header>
    <main>
      <section class="hero">
        <p class="eyebrow">Workshops & Training · ECM Integration Therapy</p>
        <h1>Innovative Somatic Bodywork <span>& Whole-Body ECM Integration</span></h1>
        <p class="lead">Exploring fascia/ECM matrix lines, protective responses and the body's capacity for change.</p>
        <svg class="wave" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 15 C220 15 250 90 510 55 S790 15 1000 65" fill="none" stroke="#b58a49" stroke-width="2"/></svg>
        <p>Developed through seven years of clinical practice and observation, Extracellular Matrix Integration Therapy (ECM-IT) explores the relationships between fascia, the extracellular matrix, protective responses, embodied experience and the body's capacity for expansion.</p>
        <p class="principle">We do not force the body to release. We learn to read its protective responses and create the conditions in which it can initiate its own expansion.</p>
        <a class="button" href="#days">Explore the two days ↓</a>
      </section>
      <section id="days" class="days">
        {workshops.map((w,i) => <article class="day">
          <div class="day-heading"><p class="eyebrow">{w.day} · {w.date}</p><span class="day-number">0{i+1}</span></div>
          <h2>{w.title}</h2><p class="subtitle">{w.subtitle}</p>
          <p>{i===0?'An educational and exploratory day introducing the foundations, observations and working hypotheses of ECM-IT.':'A day dedicated to learning through the body: guided experience, demonstration, direct observation and hands-on practice rather than classroom theory.'}</p>
          <h3>What we will explore</h3><ul>{w.topics.map(t=><li>{t}</li>)}</ul>
          <p class="audience">{w.audience}</p>
          <div class="details"><span>10:00 am–5:30 pm</span><strong>£170 per person</strong><span>Maximum 9 participants</span></div>
          <a class="button" href="#booking">Enquire about {w.day} · £170 ↗</a>
        </article>)}
      </section>
      <section class="both" id="booking"><p class="eyebrow">From understanding to embodied practice</p><h2>Experience both days</h2><p>Friday explores the foundations of ECM-IT; Saturday offers direct, hands-on learning.</p><strong>£340 for both days</strong><p class="notice">Dandelion online booking will be connected here once the published event links are available. Until then, please enquire directly; no payment is taken on this website.</p><a class="button" href="mailto:claire.graziano14@gmail.com?subject=ECM-IT%20workshop%20booking%20enquiry">Enquire about booking ↗</a></section>
      <section class="facilitator"><p class="eyebrow">Your facilitator</p><h2>Claire Graziano <small>MNCPS (Acc.)</small></h2><p>Psychotherapist · Somatic-Focused Integrative Counsellor · Trauma Recovery Specialist · Body Therapist</p><p>Founder and developer of ECM Integration Therapy. Claire brings over 23,000 hours of somatic-focused therapeutic practice and seven years of ECM-IT observations to this developing approach, grounded in attunement, consent, non-abandonment and the body's own pace.</p><blockquote>“We thrive because we thrive.”</blockquote><p class="disclaimer">ECM-IT is a developing practice-based approach. Its proposed mechanisms and clinical hypotheses require further scientific investigation.</p></section>
    </main>
    <footer><p>Centre for Somatic & Embodiment Therapies · Cambridge area<br/>Exact venue details provided to confirmed participants.</p><a href="mailto:claire.graziano14@gmail.com">claire.graziano14@gmail.com</a><a href="tel:+447565584430">07565 584430</a><a href="/">← Return home</a></footer>
  </div>
</Layout>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap');
:global(*){box-sizing:border-box}:global(body){margin:0;background:#fbf8f0;color:#25392f;font-family:'DM Sans',sans-serif;line-height:1.75}:global(html){scroll-behavior:smooth}:global(a){color:inherit}
.page{--gold:#b58a49;--forest:#254b39;--cream:#fbf8f0}.header{padding:24px max(5%,calc((100% - 1100px)/2));display:flex;align-items:center;justify-content:space-between;gap:20px;background:#f5efe3}.brand{text-decoration:none;font-weight:700;font-size:20px;line-height:1.2}.brand em{font-family:Georgia,serif;color:var(--gold)}.brand small{display:block;font-size:12px;font-weight:500;letter-spacing:.07em}.header nav{display:flex;gap:22px;flex-wrap:wrap}.header nav a{text-decoration:none;font-size:13px}.hero{padding:100px 7% 95px;text-align:center;background:linear-gradient(160deg,#f5ecdd,#e9e6db);}.hero>p:not(.eyebrow){max-width:780px;margin:22px auto}.eyebrow{text-transform:uppercase;letter-spacing:.17em;font-size:12px;font-weight:700;color:#876c43}.hero h1{max-width:950px;margin:18px auto;font-size:clamp(39px,6vw,73px);line-height:1.13;font-family:'Playfair Display',Georgia,serif;font-weight:500}.hero h1 span{display:block;color:#916f42}.lead{font-size:clamp(18px,2.5vw,24px);font-family:'Playfair Display',Georgia,serif}.wave{display:block;width:min(100%,950px);height:95px;margin:25px auto}.principle{font-family:'Playfair Display',Georgia,serif;font-size:clamp(20px,2.8vw,29px);font-style:italic;color:#52654f}.button{display:inline-block;background:var(--forest);color:white;text-decoration:none;padding:13px 25px;border-radius:50px;font-size:14px;font-weight:700;margin-top:20px}.button:hover{background:#173c2c}.days{max-width:1120px;margin:auto;padding:85px 5%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.day{padding:40px;background:#f2e9db;border-top:4px solid var(--gold);display:flex;flex-direction:column}.day:nth-child(2){background:#e5eadd}.day-heading{display:flex;justify-content:space-between;gap:10px}.day-number{font-size:34px;color:#b8a586;font-family:Georgia,serif}.day h2,.both h2,.facilitator h2{font:500 clamp(28px,3vw,40px)/1.25 'Playfair Display',Georgia,serif;margin:8px 0 12px}.subtitle{font-weight:700;color:#906f44}.day h3{font-size:15px;margin-top:20px}.day ul{padding-left:22px;flex:1}.day li{margin-bottom:9px}.audience{font-size:14px}.details{display:flex;flex-wrap:wrap;gap:10px 20px;border-top:1px solid #c9b99d;padding-top:18px;font-size:14px}.details strong{color:#8a6430}.day .button{align-self:flex-start}.both{text-align:center;background:#dce5da;padding:80px 7%}.both p{max-width:650px;margin:15px auto}.both strong{display:block;font-size:28px;color:#835d2e}.both .notice{font-size:13px;max-width:550px}.facilitator{max-width:830px;margin:0 auto;padding:90px 7%;text-align:center}.facilitator h2 small{font:500 17px 'DM Sans',sans-serif;white-space:nowrap}.facilitator blockquote{font:italic 26px 'Playfair Display',Georgia,serif;color:#876c43}.disclaimer{font-size:13px;color:#607064}footer{background:#254b39;color:#f9f5ec;display:flex;flex-wrap:wrap;justify-content:center;gap:15px 30px;align-items:center;padding:35px 7%;font-size:13px}footer p{margin:0}footer a{text-underline-offset:4px}@media(max-width:720px){.header{flex-direction:column;align-items:flex-start;padding:20px 6%}.hero{padding:65px 6%}.days{grid-template-columns:1fr;padding:55px 5%}.day{padding:28px}.wave{height:55px}}
</style>